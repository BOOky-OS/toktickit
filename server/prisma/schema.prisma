generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(80)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]
}

model User {
  id                 Int                  @id @default(autoincrement())
  displayName        String               @db.VarChar(120)
  email              String               @unique @db.VarChar(254)
  isActive           Boolean              @default(true)
  role               UserRole             @default(REQUESTER)
  passwordHash       String?
  mustChangePassword Boolean              @default(true)
  passwordChangedAt  DateTime?
  version            Int                  @default(1)
  seedKey            String?              @unique @db.VarChar(80)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  tickets            Ticket[]             @relation("TicketRequester")
  ownedTickets       Ticket[]             @relation("TicketOwner")
  removedAttachments Attachment[]         @relation("AttachmentRemovedBy")
  sessions           Session[]
  publicComments     PublicComment[]
  internalNotes      InternalNote[]
  statusChanges      TicketStatusChange[]
  performedActions   ActionTaken[]        @relation("ActionPerformer")
  assignedActions    ActionTaken[]        @relation("ActionAssignee")
  actionRevisions    ActionRevision[]
  actionReceipts     ActionReceipt[]
}

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMIN
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    Int?
  tokenHash String    @unique @db.Char(64)
  csrfToken String    @db.VarChar(64)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]
}

model Ticket {
  id                             Int                  @id @default(autoincrement())
  ticketNumber                   String               @unique @db.VarChar(20)
  ticketDate                     DateTime             @default(now())
  requesterId                    Int
  categoryId                     Int
  relatedSystemId                Int
  summary                        String               @db.VarChar(120)
  description                    String               @db.VarChar(4000)
  requestedPriority              RequestedPriority
  itPriority                     ItPriority
  currentStatus                  TicketStatus         @default(NEW)
  clientSubmissionKey            String               @db.Uuid
  createdAt                      DateTime             @default(now())
  updatedAt                      DateTime             @updatedAt
  ownerId                        Int?
  version                        Int                  @default(1)
  workCycle                      Int                  @default(1)
  requesterResolutionIndicatedAt DateTime?
  resolvedAt                     DateTime?
  closedAt                       DateTime?
  cancelledAt                    DateTime?
  resolutionSummary              String?              @db.VarChar(1000)
  cancellationReason             String?              @db.VarChar(1000)
  seedKey                        String?              @unique @db.VarChar(80)
  requester                      User                 @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  owner                          User?                @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  category                       Category             @relation(fields: [categoryId], references: [id])
  relatedSystem                  RelatedSystem        @relation(fields: [relatedSystemId], references: [id])
  attachments                    Attachment[]
  publicComments                 PublicComment[]
  internalNotes                  InternalNote[]
  statusChanges                  TicketStatusChange[]
  actions                        ActionTaken[]

  @@unique([requesterId, clientSubmissionKey])
  @@index([requesterId, resolvedAt, id])
  @@index([requesterId, updatedAt])
  @@index([requesterId, currentStatus])
  @@index([requesterId, requestedPriority])
  @@index([requesterId, categoryId])
  @@index([currentStatus, updatedAt, id])
  @@index([ownerId, updatedAt, id])
  @@index([itPriority, updatedAt, id])
}

enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
}

enum ItPriority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

model Attachment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  originalFilename String    @db.VarChar(255)
  storageKey       String    @unique @db.VarChar(255)
  mimeType         String    @db.VarChar(100)
  sizeBytes        Int
  uploadedAt       DateTime  @default(now())
  removedAt        DateTime?
  removalReason    String?   @db.VarChar(250)
  removedByUserId  Int?
  ticket           Ticket    @relation(fields: [ticketId], references: [id])
  removedByUser    User?     @relation("AttachmentRemovedBy", fields: [removedByUserId], references: [id], onDelete: Restrict)

  @@index([ticketId, removedAt])
}

model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now())
  seedKey   String?  @unique @db.VarChar(80)
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt, id])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String   @db.VarChar(4000)
  createdAt DateTime @default(now())
  seedKey   String?  @unique @db.VarChar(80)
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt, id])
}

model TicketStatusChange {
  id         Int          @id @default(autoincrement())
  ticketId   Int
  authorId   Int
  fromStatus TicketStatus
  toStatus   TicketStatus
  reason     String?      @db.VarChar(1000)
  createdAt  DateTime     @default(now())
  ticket     Ticket       @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author     User         @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt, id])
}

enum ActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActionEvent {
  CREATE
  EDIT
  STATUS
}

model ActionTaken {
  id                 Int              @id @default(autoincrement())
  ticketId           Int
  performedById      Int
  assigneeId         Int
  actionAt           DateTime
  description        String           @db.VarChar(2000)
  result             String           @db.VarChar(2000)
  followUpRequired   Boolean
  followUpNote       String           @db.VarChar(1000)
  attachmentNotes    String           @db.VarChar(1000)
  status             ActionStatus     @default(PLANNED)
  workCycle          Int
  version            Int              @default(1)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?          @db.VarChar(1000)
  seedKey            String?          @unique @db.VarChar(80)
  ticket             Ticket           @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  performedBy        User             @relation("ActionPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  assignee           User             @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  revisions          ActionRevision[]

  @@index([ticketId, createdAt, id])
  @@index([ticketId, workCycle, status])
  @@index([assigneeId, status, updatedAt, id])
}

model ActionRevision {
  id        Int         @id @default(autoincrement())
  actionId  Int
  actorId   Int
  version   Int
  event     ActionEvent
  snapshot  Json
  createdAt DateTime    @default(now())
  action    ActionTaken @relation(fields: [actionId], references: [id], onDelete: Restrict)
  actor     User        @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actionId, version])
}

model ActionReceipt {
  id             Int      @id @default(autoincrement())
  actorId        Int
  key            String   @db.Uuid
  method         String   @db.VarChar(10)
  path           String   @db.VarChar(200)
  request        Json
  responseStatus Int
  response       Json
  createdAt      DateTime @default(now())
  actor          User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, key])
}
