# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file.
DATABASE_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit?schema=public"
PORT=3000

# Tests refuse the working database and use random owned schemas in this local DB.
TEST_DATABASE_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit_lab3_test?schema=public"
# Local demo seed is OFF unless explicitly enabled.
LAB3_ALLOW_DEMO_SEED=false
# Set LAB3_MIGRATION_INITIAL_PASSWORD privately only when provisioning null hashes.

# Browser origin must match exactly; enable HTTP cookies only for local development.
CLIENT_ORIGIN="http://localhost:5173"
ALLOW_LOCAL_HTTP=true
